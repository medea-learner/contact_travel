<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Search View for Voyages -->
  <record id="voyage_search_view" model="ir.ui.view">
      <field name="name">voyage.search</field>
      <field name="model">contact_travel.voyage</field>
      <field name="arch" type="xml">
          <search>
              <field name="partner_id"/>
              <field name="destination"/>
              <filter string="This Month" name="current_month" domain="[('departure_date', '&gt;=', context_today().replace(day=1)), ('departure_date', '&lt;=', context_today())]"/>
          </search>
      </field>
  </record>

  <!-- Action to open the list of voyages -->
  <record id="action_voyage" model="ir.actions.act_window">
    <field name="name">Voyages</field>
    <field name="res_model">contact_travel.voyage</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="voyage_search_view"/> 
    <field name="help" type="html">
        <p>Liste des voyages associés à ce contact.</p>
    </field>
  </record>

  <!-- Tree (list) View for Voyages -->
  <record id="voyage_tree_view" model="ir.ui.view">
    <field name="name">voyage.tree</field>
    <field name="model">contact_travel.voyage</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="departure_date"/>
        <field name="destination"/>
        <field name="partner_id"/>
        <field name="amount"/>
      </list>
    </field>
  </record>

  <!-- Form View for Voyages -->
  <record id="voyage_form_view" model="ir.ui.view">
    <field name="name">voyage.form</field>
    <field name="model">contact_travel.voyage</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="departure_date"/>
            <field name="destination"/>
            <field name="partner_id"/>
            <field name="amount"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Menu Item -->
  <menuitem 
    id="menu_voyage" 
    name="Voyages" 
    parent="contacts.menu_contacts" 
    action="action_voyage" 
    sequence="10"/>
</odoo>
