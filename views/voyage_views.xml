<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Action to view voyages -->
  <record id="action_voyage" model="ir.actions.act_window">
    <field name="name">Voyages</field>
    <field name="res_model">contact_travel.voyage</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_partner_id': active_id}</field>
    <field name="domain">[('partner_id', '=', active_id)]</field>
    <field name="help" type="html">
      <p>Liste des voyages liés à ce contact.</p>
    </field>
  </record>

  <!-- Tree (list) View for Voyages -->
  <record id="voyage_tree_view" model="ir.ui.view">
    <field name="name">voyage.tree</field>
    <field name="model">contact_travel.voyage</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="departure_date"/>
        <field name="destination"/>
        <field name="partner_id"/>
        <field name="amount"/>
      </list>
    </field>
  </record>

  <!-- Form View for Voyages -->
  <record id="voyage_form_view" model="ir.ui.view">
    <field name="name">voyage.form</field>
    <field name="model">contact_travel.voyage</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="departure_date"/>
            <field name="destination"/>
            <field name="partner_id"/>
            <field name="amount"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
